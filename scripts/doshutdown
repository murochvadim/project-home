#!/bin/bash
# /etc/apcupsd/doshutdown — invoked by apccontrol on battery-low.
#
# Phased shutdown sequence (added 2026-04-30) protects against transactions
# rolled back when Postgres or MQTT die while clients are still mid-write:
#
#   [1] QNAP halt (CGI) — issued first, has its own boot-down sequence
#   [2] Phase A — clients sequential, 60 s each: 100, 101, 103, 104, 105, 106, 108, 109, 110, 111
#       things that write to Postgres / MQTT must finish before services die
#   [3] Phase B — services sequential, 30 s each: 102 (Postgres), 107 (MQTT)
#       safe to halt now — nobody is writing
#   [4] Write Phase 4 marker → halt PVE
#
# SAFETY_MODE: if /etc/apcupsd/SAFETY_MODE exists, log only — DO NOT shutdown.
# Remove that file once you have verified the dry-run + KILLPOWER tests.

LOG=/var/log/apcupsd_shutdown.log
exec >> "$LOG" 2>&1
echo
echo "================================================================"
echo "$(date +%Y-%m-%d_%H:%M:%S) — apcupsd doshutdown invoked"
echo "================================================================"

if [ -f /etc/apcupsd/SAFETY_MODE ]; then
  echo "[SAFETY MODE] /etc/apcupsd/SAFETY_MODE exists — would have run orchestrator + shutdown PVE."
  echo "[SAFETY MODE] No action taken. Remove the file to enable real shutdown."
  exit 0
fi

set +e

# Phase classification — see UPS/CLAUDE.md "Phased shutdown"
# Format: "<id>:<type>" so we can keep numerical order with mixed LXCs / VMs.
# Phase A iteration is in numerical order so logs read 100 → 101 → 103 …
PHASE_A_CLIENTS=(100:lxc 101:vm 103:lxc 104:lxc 105:lxc 106:lxc 108:lxc 109:lxc 110:lxc 111:lxc)
PHASE_B_SERVICES=(102:lxc 107:lxc)

is_running_lxc() { pct status "$1" 2>/dev/null | grep -q running; }
is_running_vm()  { qm  status "$1" 2>/dev/null | grep -q running; }

shutdown_one() {
  # Sequential — blocks until the guest is stopped (or pct/qm timeout fires)
  # so the next guest in the list does not start shutting down until this
  # one is fully halted. Predictable numerical order in the logs, no I/O
  # contention from concurrent guest halts.
  local id="${1%:*}" type="${1#*:}" timeout="$2"
  local t0=$(date +%s)
  if [ "$type" = "lxc" ]; then
    if is_running_lxc "$id"; then
      echo "  pct shutdown $id (LXC, ${timeout}s max) — waiting…"
      pct shutdown "$id" --forceStop 1 --timeout "$timeout"
      echo "    → LXC $id stopped (took $(( $(date +%s) - t0 ))s)"
    else
      echo "  LXC $id — already stopped, skipping"
    fi
  else
    if is_running_vm "$id"; then
      echo "  qm shutdown $id (VM, ${timeout}s max) — waiting…"
      qm shutdown "$id" --forceStop --timeout "$timeout"
      echo "    → VM $id stopped (took $(( $(date +%s) - t0 ))s)"
    else
      echo "  VM $id — already stopped, skipping"
    fi
  fi
}

# ---- [1] External peer: QNAP ----
echo "[1/4] poweroff QNAP (192.168.1.155)"
timeout 12 /etc/apcupsd/qnap_halt.sh \
  && echo "  QNAP halt issued (CGI)" \
  || echo "  QNAP halt failed / unreachable (continuing)"

# ---- [2] Phase A — CLIENTS sequential (100 → 101 → 103 → 104 → 105 → 106 → 108 → 109 → 110 → 111) ----
echo "[2/4] Phase A — clients (sequential, 60 s per guest max)"
for entry in "${PHASE_A_CLIENTS[@]}"; do
  shutdown_one "$entry" 60
done
echo "  $(date +%Y-%m-%d_%H:%M:%S) — Phase A clients stopped"

# ---- [3] Phase B — SERVICES sequential (102 Postgres → 107 MQTT) ----
echo "[3/4] Phase B — services (sequential, 30 s per guest max)"
for entry in "${PHASE_B_SERVICES[@]}"; do
  shutdown_one "$entry" 30
done
echo "  $(date +%Y-%m-%d_%H:%M:%S) — Phase B services stopped"

sleep 5

echo "[4/4] $(date +%Y-%m-%d_%H:%M:%S) guests stopped, halting PVE"
# A1: write the "UPS halted me" marker for apcupsd-auto-recover.service
echo "ups_$(date +%s)" > /etc/apcupsd/last_shutdown_reason
exec /sbin/shutdown -h now "UPS battery low — controlled shutdown"
